---
import Base from '../../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

// The page content lives in content/index-en.md
const entry = await getEntry('home', 'index-en');
if (!entry) throw new Error('Missing content: content/index-en.md');
const { Content } = await render(entry);
const { title, description, og } = entry.data;
---
<Base title={title} description={description} og={og}>
  <script is:inline>
    localStorage.setItem('preferred-lang', 'en');
  </script>
  <main>
    <Content />
  </main>
</Base>