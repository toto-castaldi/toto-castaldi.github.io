---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { getEntry } from 'astro:content';

// Texts live in the frontmatter of content/qualifiche-en.md
const entry = await getEntry('qualifiche', 'qualifiche-en');
if (!entry) throw new Error('Missing content: content/qualifiche-en.md');
const { title, description, og, intro, back, close, certificates } = entry.data;

// Structural image data (identical in both languages)
const certificati = [
  { slug: 'pesistica', file: 'qualifica-pesistica.webp', width: 1000, height: 1414 },
  { slug: 'reformer', file: 'qualifica-pilates-reformer.webp', width: 1000, height: 707 },
  { slug: 'cadillac', file: 'qualifica-pilates-cadillac.webp', width: 1000, height: 707 },
] as const;
---
<Base
  title={title}
  description={description}
  og={og}
  alternates={{ it: '/qualifiche/', en: '/en/qualifications/' }}
>
  <main>
    <h1>{title}</h1>
    <p>{intro}</p>
    <p><a href="/en/">{back}</a></p>

    {certificati.map(({ slug, file, width, height }) => (
      <Section title={certificates[slug].label} id={slug}>
        <figure>
          <button
            type="button"
            class="zoom-trigger"
            command="show-modal"
            commandfor={`dlg-${slug}`}
            aria-label={certificates[slug].zoom}
          >
            <img
              src={`/assets/images/${file}`}
              width={width}
              height={height}
              loading="lazy"
              decoding="async"
              alt={certificates[slug].alt}
            />
          </button>
          <figcaption>{certificates[slug].body}</figcaption>
        </figure>

        <dialog id={`dlg-${slug}`} class="zoom-dialog">
          <button
            type="button"
            class="zoom-close"
            command="close"
            commandfor={`dlg-${slug}`}
            aria-label={close}
          >×</button>
          <img
            src={`/assets/images/${file}`}
            width={width}
            height={height}
            decoding="async"
            alt={certificates[slug].alt}
          />
        </dialog>
      </Section>
    ))}

    <p><a href="/en/">{back}</a></p>
  </main>
</Base>